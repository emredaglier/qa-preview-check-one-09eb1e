# Per-project settings: the one file the owner edits to make this repo a project's own.
# No secrets here (those live in GitHub secrets and the server's env files, see README.md). The
# scripts in this folder, the Compose and Caddy files, CI and the smoke suite all read these values.
# An environment variable of the same name wins over the file.
#
# Format: KEY=value, one per line. No quotes, no spaces around `=`.

# Short lowercase name. It becomes the Compose project, the image names (ghcr.io/<owner>/<name>),
# the server folder /opt/<name>, the R2 bucket names (<name>-media, <name>-db-backups,
# <name>-backup) and the Tailscale machine name. Letters, digits and hyphens, starting with a letter.
PROJECT_NAME=house

# The public apex domain (the site is served at https://<DOMAIN>, www redirects to it).
# `example.com` is the template's placeholder: deploy and Cloudflare steps refuse to run with it.
DOMAIN=example.com

# Where /_next/static and media are served from (R2 behind Cloudflare). Default: cdn.<DOMAIN>.
# CDN_HOST=cdn.example.com

# Tailscale machine name of the server (admin and preview are at https://<name>.<tailnet>.ts.net).
# Default: PROJECT_NAME.
# TS_HOSTNAME=house

# Time zone of the weekly reboot window (Sunday 04:00), an IANA name. Default: UTC.
# TIMEZONE=UTC
