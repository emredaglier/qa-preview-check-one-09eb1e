# Copy to .env (git-ignored) and fill in. Never commit real values.
# The runtime values below are read on the first request; `next build` needs none of them. The
# build reads only the two optional build-time values at the end (Docker build args).

# The SAME SQLite file `cms` writes. Relative paths resolve against the working directory
# (apps/web for `pnpm dev`). web opens it read-only (PRAGMA query_only) but the directory must be
# writable, because WAL readers need the -shm file.
DATABASE_PATH=../cms/data/site.db

# Required by the shared Payload config, but web never signs or verifies anything (no admin, no
# API, no sessions). Use its OWN random value, never the cms one, so a leak from the public
# container cannot forge admin sessions: `openssl rand -hex 32`.
PAYLOAD_SECRET=change-me-web-only

# Shared secret that cms sends to POST /internal/revalidate. Must equal cms's REVALIDATE_SECRET.
# `openssl rand -hex 32`. Leave unset to refuse all revalidation requests.
# REVALIDATE_SECRET=change-me-too

# --- Build time only (`next build`; in Docker the ASSET_PREFIX / DEPLOYMENT_ID build args) ---
# Both optional. Where the browser loads /_next/static from. Unset: same origin.
# ASSET_PREFIX=https://cdn.example.com/releases/<sha>
# Skew protection: Next adds ?dpl=<id> to asset URLs and hard-navigates when a client from an
# older release meets a newer server. Use the release's commit sha.
# DEPLOYMENT_ID=<sha>
