# Copy to .env (git-ignored) and fill in. Never commit real values.

# Path of the SQLite file. Relative paths resolve against the working directory (apps/cms for
# `pnpm dev`). The directory is created if it is missing; the file's directory also holds the
# -wal and -shm files, so keep it on a local disk.
DATABASE_PATH=./data/site.db

# Signs sessions. Any long random string: `openssl rand -hex 32`. Only cms has this value; web
# has a different one of its own.
PAYLOAD_SECRET=change-me

# Optional. "true" pushes the schema straight to the DB on startup (default: only under `next dev`).
# Everything else, including production, uses the committed migrations in packages/cms-config.
# PAYLOAD_DB_PUSH=true

# Comma-separated origins allowed to use the admin API with cookies (CORS and Payload's CSRF
# check), e.g. the tailnet HTTPS URL. REQUIRED when NODE_ENV=production: cms refuses to start
# without it, because an empty list turns the CSRF check off. `next build` is exempt.
# CMS_ORIGINS=https://cms.your-tailnet.ts.net:9443

# Optional. Where cms tells web to drop its cache after a save: a comma-separated list of full
# URLs plus the shared secret (the same value web has as REVALIDATE_SECRET). A failed call is
# logged and never fails the save.
# REVALIDATE_URLS=http://localhost:3000/internal/revalidate
# REVALIDATE_SECRET=change-me-too
